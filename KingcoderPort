<style>
:root{
  --bg:#070708;
  --panel:#0d0d10;
  --panel2:#111116;
  --text:#f2f2f4;
  --muted:#8b8b95;
  --red:#e24b4a;
  --red2:#ff6866;
  --line:#222228;
  --mono:"Share Tech Mono",monospace;
  --head:"Rajdhani",sans-serif;
  --body:"Inter",sans-serif;
}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{
  background:var(--bg);
  color:var(--text);
  font-family:var(--body);
  line-height:1.6;
  overflow-x:hidden;
}
body:before{
  content:"";
  position:fixed;
  inset:0;
  pointer-events:none;
  opacity:.035;
  background:repeating-linear-gradient(0deg,transparent 0,transparent 2px,#fff 3px);
  z-index:10;
}
a{color:inherit;text-decoration:none}
.container{width:min(1120px,92%);margin:auto}
.nav{
  height:76px;
  border-bottom:1px solid var(--line);
  display:flex;
  align-items:center;
  justify-content:space-between;
  position:sticky;
  top:0;
  background:rgba(7,7,8,.88);
  backdrop-filter:blur(12px);
  z-index:20;
}
.logo{
  font:700 27px var(--head);
  letter-spacing:2px;
}
.logo span{color:var(--red)}
.navlinks{display:flex;gap:30px;font-size:13px;color:#aaa}
.navlinks a{transition:.2s}
.navlinks a:hover{color:#fff}
.status{
  border:1px solid #263f2c;
  background:#0b120d;
  color:#74d98a;
  padding:7px 11px;
  border-radius:4px;
  font:12px var(--mono);
}
.status i{
  display:inline-block;
  width:6px;height:6px;
  border-radius:50%;
  background:#5ee47a;
  margin-right:7px;
  box-shadow:0 0 8px #5ee47a;
}

.hero{
  min-height:650px;
  display:flex;
  align-items:center;
  position:relative;
  border-bottom:1px solid var(--line);
}
.hero:after{
  content:"";
  position:absolute;
  width:520px;height:520px;
  right:-170px;top:40px;
  background:radial-gradient(circle,rgba(226,75,74,.14),transparent 68%);
  pointer-events:none;
}
.eyebrow{
  color:var(--red);
  font:14px var(--mono);
  margin-bottom:18px;
}
.hero h1{
  font:700 clamp(65px,10vw,125px)/.78 var(--head);
  letter-spacing:-4px;
  margin-left:-6px;
}
.hero h1 span{color:var(--red)}
.hero h2{
  margin-top:28px;
  font:700 clamp(35px,6vw,70px)/.9 var(--head);
  letter-spacing:1px;
}
.hero p{
  max-width:650px;
  color:var(--muted);
  margin-top:24px;
  font-size:15px;
}
.buttons{display:flex;gap:12px;margin-top:30px}
.btn{
  padding:12px 20px;
  border:1px solid var(--line);
  font-size:13px;
  font-weight:600;
  transition:.2s;
}
.btn.primary{background:var(--red);border-color:var(--red);color:#fff}
.btn:hover{transform:translateY(-2px);border-color:var(--red)}
.btn.primary:hover{background:var(--red2)}
.stats{
  display:flex;
  gap:45px;
  margin-top:55px;
}
.stat strong{
  display:block;
  font:700 28px var(--head);
}
.stat small{
  color:#666;
  text-transform:uppercase;
  letter-spacing:1px;
  font-size:9px;
}

.marquee{
  border-bottom:1px solid var(--line);
  overflow:hidden;
  white-space:nowrap;
  padding:17px 0;
  color:#68686f;
  font:12px var(--mono);
}
.marquee div{
  display:inline-block;
  animation:move 25s linear infinite;
}
.marquee span{margin:0 28px}
.marquee b{color:var(--red)}
@keyframes move{to{transform:translateX(-50%)}}

section{padding:100px 0}
.section-top{
  display:flex;
  justify-content:space-between;
  align-items:end;
  margin-bottom:45px;
}
.label{font:12px var(--mono);color:var(--red)}
.section-title{
  font:700 48px var(--head);
  letter-spacing:-1px;
  margin-top:7px;
}
.section-desc{max-width:390px;color:var(--muted);font-size:13px}

.grid{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:14px;
}
.card{
  background:var(--panel);
  border:1px solid var(--line);
  padding:27px;
  position:relative;
  transition:.25s;
}
.card:hover{
  transform:translateY(-4px);
  border-color:#38383f;
}
.card:before{
  content:"";
  position:absolute;
  top:-1px;left:25px;
  width:35px;height:2px;
  background:var(--red);
}
.icon{
  font:20px var(--mono);
  color:var(--red);
  margin-bottom:22px;
}
.card h3{
  font:700 24px var(--head);
  margin-bottom:9px;
}
.card p{color:var(--muted);font-size:12px}
.tags{
  display:flex;
  flex-wrap:wrap;
  gap:6px;
  margin-top:20px;
}
.tag{
  border:1px solid var(--line);
  color:#85858d;
  padding:4px 7px;
  font:9px var(--mono);
}

.projects{background:#09090b}
.project{
  padding:0;
  overflow:hidden;
}
.project-top{
  height:145px;
  display:flex;
  align-items:center;
  justify-content:center;
  background:
    linear-gradient(135deg,rgba(226,75,74,.08),transparent),
    repeating-linear-gradient(45deg,#0c0c0f 0,#0c0c0f 10px,#101014 10px,#101014 11px);
  border-bottom:1px solid var(--line);
}
.project-number{font:700 50px var(--head);color:#29292f}
.project-body{padding:25px}
.project h3{font:700 27px var(--head)}
.project .type{font:10px var(--mono);color:var(--red);margin:5px 0 15px}
.project p{color:var(--muted);font-size:12px}
.project ul{
  list-style:none;
  margin-top:17px;
  color:#999;
  font-size:11px;
}
.project li{margin:7px 0}
.project li:before{content:"→";color:var(--red);margin-right:8px}

.about-grid{
  display:grid;
  grid-template-columns:1.2fr .8fr;
  gap:50px;
}
.about h3{font:700 42px var(--head);margin-bottom:20px}
.about p{color:var(--muted);font-size:14px;margin-bottom:16px}
.profile{
  border:1px solid var(--line);
  background:var(--panel);
}
.profile-head{
  padding:20px;
  border-bottom:1px solid var(--line);
  font:11px var(--mono);
  color:var(--red);
}
.profile-row{
  display:flex;
  justify-content:space-between;
  padding:13px 20px;
  border-bottom:1px solid #19191e;
  font-size:11px;
}
.profile-row span:first-child{color:#62626a}
.profile-row span:last-child{color:#ddd}

.contact{
  text-align:center;
  border-top:1px solid var(--line);
  background:
    radial-gradient(circle at center,rgba(226,75,74,.09),transparent 45%);
}
.contact h2{
  font:700 clamp(50px,8vw,90px) var(--head);
}
.contact p{color:var(--muted);margin:15px auto 25px}
.discord{
  display:inline-block;
  border:1px solid var(--line);
  padding:14px 24px;
  font:13px var(--mono);
  transition:.2s;
}
.discord:hover{border-color:var(--red);color:var(--red)}

footer{
  border-top:1px solid var(--line);
  padding:25px 0;
  color:#555;
  font:10px var(--mono);
  display:flex;
  justify-content:space-between;
}
footer span{color:var(--red)}

@media(max-width:800px){
  .navlinks{display:none}
  .hero{min-height:590px}
  .hero h1{font-size:70px}
  .stats{gap:20px}
  .grid{grid-template-columns:1fr 1fr}
  .about-grid{grid-template-columns:1fr}
  .section-top{display:block}
  .section-desc{margin-top:15px}
}
@media(max-width:540px){
  .status{display:none}
  section{padding:70px 0}
  .hero h1{font-size:62px;letter-spacing:-2px}
  .hero h2{font-size:39px}
  .hero p{font-size:13px}
  .stats{flex-wrap:wrap;margin-top:40px}
  .grid{grid-template-columns:1fr}
  .section-title{font-size:40px}
  .buttons{flex-wrap:wrap}
}
</style>
</head>

