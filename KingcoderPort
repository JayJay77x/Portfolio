<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>KingCoder — Lua Developer</title>
<link href="https://fonts.googleapis.com/css2?family=Rajdhani:wght@400;500;600;700&family=Share+Tech+Mono&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet"/>
<style>
*{margin:0;padding:0;box-sizing:border-box;}
:root{
  --accent:#E24B4A;
  --accent2:#F09595;
  --accent-dim:rgba(226,75,74,0.15);
  --accent-border:rgba(226,75,74,0.3);
  --g900:#07070a;
  --g800:#0e0e14;
  --g700:#15151e;
  --g600:#1e1e2a;
  --g500:#2a2a38;
  --g400:#888799;
  --g200:#b4b2c8;
  --g100:#d3d1e8;
  --white:#f0efff;
}
html{scroll-behavior:smooth;}
body{background:var(--g900);color:var(--g100);font-family:'Inter',sans-serif;overflow-x:hidden;}
::-webkit-scrollbar{width:4px;}
::-webkit-scrollbar-track{background:var(--g900);}
::-webkit-scrollbar-thumb{background:var(--accent);border-radius:2px;}
nav{position:fixed;top:0;left:0;right:0;z-index:100;padding:1.25rem 3rem;display:flex;justify-content:space-between;align-items:center;background:rgba(7,7,10,0.85);backdrop-filter:blur(20px);border-bottom:1px solid rgba(226,75,74,0.08);}
.nav-logo{font-family:'Rajdhani',sans-serif;font-size:1.4rem;font-weight:700;color:var(--white);letter-spacing:0.05em;}
.nav-logo span{color:var(--accent);}
.nav-links{display:flex;gap:2.5rem;}
.nav-links a{font-family:'Share Tech Mono',monospace;font-size:11px;color:var(--g400);text-decoration:none;letter-spacing:0.12em;text-transform:uppercase;transition:color 0.2s;}
.nav-links a:hover{color:var(--accent);}
.nav-badge{font-family:'Share Tech Mono',monospace;font-size:11px;color:var(--accent2);background:var(--accent-dim);border:1px solid var(--accent-border);padding:5px 14px;border-radius:100px;display:flex;align-items:center;gap:7px;}
.nav-dot{width:6px;height:6px;background:#4ade80;border-radius:50%;animation:blink 2s infinite;}
@keyframes blink{0%,100%{opacity:1;}50%{opacity:0.3;}}
.hero{min-height:100vh;display:flex;flex-direction:column;justify-content:center;padding:8rem 3rem 4rem;position:relative;overflow:hidden;}
.hero-glow-1{position:absolute;top:-20%;right:-10%;width:700px;height:700px;border-radius:50%;background:radial-gradient(circle, rgba(226,75,74,0.08) 0%, transparent 70%);pointer-events:none;}
.hero-glow-2{position:absolute;bottom:-30%;left:-10%;width:600px;height:600px;border-radius:50%;background:radial-gradient(circle, rgba(226,75,74,0.05) 0%, transparent 70%);pointer-events:none;}
.hero-grid{position:absolute;inset:0;background-image:linear-gradient(rgba(226,75,74,0.03) 1px, transparent 1px),linear-gradient(90deg, rgba(226,75,74,0.03) 1px, transparent 1px);background-size:60px 60px;mask-image:radial-gradient(ellipse 80% 80% at 50% 50%, black 30%, transparent 100%);pointer-events:none;}
.hero-eyebrow{display:flex;align-items:center;gap:12px;margin-bottom:2rem;}
.hero-line{width:40px;height:1px;background:var(--accent);}
.hero-eyebrow-text{font-family:'Share Tech Mono',monospace;font-size:11px;color:var(--accent);letter-spacing:0.2em;text-transform:uppercase;}
.hero-name{font-family:'Rajdhani',sans-serif;font-size:clamp(1rem,3vw,1.4rem);font-weight:500;color:var(--g400);letter-spacing:0.3em;text-transform:uppercase;margin-bottom:0.5rem;}
h1{font-family:'Rajdhani',sans-serif;font-size:clamp(4rem,12vw,9rem);font-weight:700;line-height:0.85;color:var(--white);letter-spacing:-0.03em;margin-bottom:2.5rem;position:relative;}
h1 .accent{color:var(--accent);}
h1 .outline{-webkit-text-stroke:2px var(--white);color:transparent;}
.hero-desc{font-size:1.1rem;color:var(--g200);max-width:560px;line-height:1.8;font-weight:300;margin-bottom:3rem;border-left:2px solid var(--accent);padding-left:1.5rem;}
.hero-stats{display:flex;gap:3rem;margin-bottom:3.5rem;flex-wrap:wrap;}
.stat{position:relative;}
.stat-num{font-family:'Rajdhani',sans-serif;font-size:2.8rem;font-weight:700;color:var(--white);line-height:1;}
.stat-num sup{color:var(--accent);font-size:1.5rem;}
.stat-label{font-family:'Share Tech Mono',monospace;font-size:10px;color:var(--g400);letter-spacing:0.15em;text-transform:uppercase;margin-top:4px;}
.stat-divider{width:1px;background:rgba(255,255,255,0.08);align-self:stretch;}
.hero-cta{display:flex;gap:1rem;flex-wrap:wrap;}
.btn{padding:14px 32px;border-radius:3px;font-size:13px;font-weight:600;cursor:pointer;text-decoration:none;display:inline-flex;align-items:center;gap:8px;letter-spacing:0.08em;text-transform:uppercase;transition:all 0.25s;font-family:'Share Tech Mono',monospace;}
.btn-primary{background:var(--accent);color:#fff;box-shadow:0 0 30px rgba(226,75,74,0.3);}
.btn-primary:hover{background:#c93f3e;box-shadow:0 0 40px rgba(226,75,74,0.5);transform:translateY(-2px);}
.btn-ghost{background:transparent;color:var(--g200);border:1px solid rgba(255,255,255,0.15);}
.btn-ghost:hover{border-color:var(--accent);color:var(--accent);transform:translateY(-2px);}
.btn-arrow{font-size:16px;transition:transform 0.2s;}
.btn-primary:hover .btn-arrow{transform:translateX(4px);}
.marquee-wrap{background:var(--g800);border-top:1px solid rgba(255,255,255,0.05);border-bottom:1px solid rgba(255,255,255,0.05);padding:1rem 0;overflow:hidden;}
.marquee-track{display:flex;gap:0;animation:marquee 20s linear infinite;width:max-content;}
@keyframes marquee{from{transform:translateX(0);}to{transform:translateX(-50%);}}
.marquee-item{font-family:'Share Tech Mono',monospace;font-size:12px;color:var(--g400);letter-spacing:0.15em;text-transform:uppercase;padding:0 2rem;display:flex;align-items:center;gap:2rem;white-space:nowrap;}
.marquee-dot{width:4px;height:4px;background:var(--accent);border-radius:50%;flex-shrink:0;}
section{padding:7rem 3rem;}
.section-header{margin-bottom:4rem;}
.section-eyebrow{font-family:'Share Tech Mono',monospace;font-size:11px;color:var(--accent);letter-spacing:0.2em;text-transform:uppercase;margin-bottom:1rem;display:flex;align-items:center;gap:10px;}
.section-eyebrow::before{content:'';display:block;width:20px;height:1px;background:var(--accent);}
h2{font-family:'Rajdhani',sans-serif;font-size:clamp(2rem,5vw,4rem);font-weight:700;color:var(--white);line-height:0.95;letter-spacing:-0.02em;}
h2 span{color:var(--accent);}
.skills-section{background:var(--g800);position:relative;overflow:hidden;}
.skills-bg{position:absolute;right:-200px;top:50%;transform:translateY(-50%);width:600px;height:600px;border-radius:50%;background:radial-gradient(circle, rgba(226,75,74,0.04) 0%, transparent 70%);pointer-events:none;}
.skills-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:rgba(255,255,255,0.04);border:1px solid rgba(255,255,255,0.04);}
@media(max-width:900px){.skills-grid{grid-template-columns:repeat(2,1fr);}}
@media(max-width:600px){.skills-grid{grid-template-columns:1fr;}}
.skill-card{background:var(--g800);padding:2.5rem;display:flex;flex-direction:column;gap:1rem;transition:background 0.3s;position:relative;overflow:hidden;}
.skill-card::before{content:'';position:absolute;inset:0;background:linear-gradient(135deg, rgba(226,75,74,0.05) 0%, transparent 60%);opacity:0;transition:opacity 0.3s;}
.skill-card:hover{background:var(--g700);}
.skill-card:hover::before{opacity:1;}
.skill-num{font-family:'Share Tech Mono',monospace;font-size:11px;color:rgba(226,75,74,0.4);letter-spacing:0.1em;}
.skill-icon-wrap{width:48px;height:48px;border-radius:6px;background:var(--accent-dim);border:1px solid var(--accent-border);display:flex;align-items:center;justify-content:center;font-size:22px;}
.skill-name{font-family:'Rajdhani',sans-serif;font-size:1.25rem;font-weight:700;color:var(--white);}
.skill-desc{font-size:13px;color:var(--g400);line-height:1.7;}
.skill-bar-wrap{margin-top:auto;padding-top:1rem;}
.skill-bar-label{display:flex;justify-content:space-between;font-family:'Share Tech Mono',monospace;font-size:10px;color:var(--g400);margin-bottom:6px;letter-spacing:0.1em;}
.skill-bar-bg{height:2px;background:rgba(255,255,255,0.06);border-radius:1px;}
.skill-bar{height:100%;background:linear-gradient(90deg, var(--accent), var(--accent2));border-radius:1px;}
.projects-section{background:var(--g900);}
.projects-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:1.5rem;}
@media(max-width:700px){.projects-grid{grid-template-columns:1fr;}}
.project-card{background:var(--g700);border:1px solid rgba(255,255,255,0.05);border-radius:4px;overflow:hidden;transition:all 0.3s;position:relative;}
.project-card::after{content:'';position:absolute;inset:0;border:1px solid var(--accent);border-radius:4px;opacity:0;transition:opacity 0.3s;}
.project-card:hover{transform:translateY(-4px);background:var(--g600);}
.project-card:hover::after{opacity:0.4;}
.project-img{height:180px;background:var(--g600);display:flex;align-items:center;justify-content:center;font-size:4rem;position:relative;overflow:hidden;border-bottom:1px solid rgba(255,255,255,0.05);}
.project-img-bg{position:absolute;inset:0;background:linear-gradient(135deg, rgba(226,75,74,0.08) 0%, transparent 60%);}
.project-body{padding:1.75rem;}
.project-type{font-family:'Share Tech Mono',monospace;font-size:10px;color:var(--accent);letter-spacing:0.15em;text-transform:uppercase;margin-bottom:0.6rem;}
.project-name{font-family:'Rajdhani',sans-serif;font-size:1.5rem;font-weight:700;color:var(--white);margin-bottom:0.75rem;}
.project-desc{font-size:13px;color:var(--g400);line-height:1.7;margin-bottom:1.25rem;}
.project-tags{display:flex;gap:0.5rem;flex-wrap:wrap;}
.tag{font-size:11px;padding:4px 12px;border-radius:2px;background:var(--accent-dim);color:var(--accent2);font-family:'Share Tech Mono',monospace;letter-spacing:0.05em;border:1px solid var(--accent-border);}
.about-section{background:var(--g800);position:relative;}
.about-grid{display:grid;grid-template-columns:1.2fr 1fr;gap:5rem;align-items:start;}
@media(max-width:800px){.about-grid{grid-template-columns:1fr;gap:3rem;}}
.about-text{font-size:1rem;color:var(--g200);line-height:1.9;font-weight:300;}
.about-text p+p{margin-top:1.25rem;}
.about-quote{font-family:'Rajdhani',sans-serif;font-size:1.5rem;font-weight:600;color:var(--white);line-height:1.4;border-left:3px solid var(--accent);padding-left:1.5rem;margin-bottom:2rem;}
.specs-card{background:var(--g700);border:1px solid rgba(255,255,255,0.06);border-radius:4px;overflow:hidden;}
.specs-header{padding:1rem 1.5rem;background:var(--accent-dim);border-bottom:1px solid var(--accent-border);font-family:'Share Tech Mono',monospace;font-size:11px;color:var(--accent);letter-spacing:0.15em;text-transform:uppercase;}
.spec-row{display:flex;justify-content:space-between;align-items:center;padding:0.9rem 1.5rem;border-bottom:1px solid rgba(255,255,255,0.04);font-size:13px;}
.spec-row:last-child{border-bottom:none;}
.spec-key{color:var(--g400);font-family:'Share Tech Mono',monospace;font-size:10px;letter-spacing:0.1em;text-transform:uppercase;}
.spec-val{color:var(--white);font-weight:500;}
.spec-val.green{color:#4ade80;}
.spec-val.red{color:var(--accent);}
.contact-section{background:var(--g900);text-align:center;position:relative;overflow:hidden;}
.contact-glow{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:800px;height:400px;background:radial-gradient(ellipse, rgba(226,75,74,0.07) 0%, transparent 70%);pointer-events:none;}
.contact-inner{max-width:640px;margin:0 auto;position:relative;}
.contact-big{font-family:'Rajdhani',sans-serif;font-size:clamp(3rem,10vw,7rem);font-weight:700;color:var(--white);line-height:0.9;letter-spacing:-0.03em;margin-bottom:1.5rem;}
.contact-big span{color:var(--accent);}
.contact-sub{font-size:1rem;color:var(--g400);line-height:1.7;margin-bottom:3rem;max-width:480px;margin-left:auto;margin-right:auto;}
.contact-card{background:var(--g700);border:1px solid rgba(226,75,74,0.2);border-radius:4px;padding:2.5rem;position:relative;overflow:hidden;}
.contact-card::before{content:'';position:absolute;top:0;left:0;right:0;height:2px;background:linear-gradient(90deg, transparent, var(--accent), transparent);}
.contact-label{font-family:'Share Tech Mono',monospace;font-size:11px;color:var(--g400);letter-spacing:0.15em;text-transform:uppercase;margin-bottom:1rem;}
.discord-handle{font-family:'Rajdhani',sans-serif;font-size:2.2rem;font-weight:700;color:var(--accent);margin-bottom:0.5rem;}
.contact-note{font-size:12px;color:var(--g400);font-family:'Share Tech Mono',monospace;}
footer{background:var(--g800);padding:2rem 3rem;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:1rem;border-top:1px solid rgba(255,255,255,0.04);}
.footer-logo{font-family:'Rajdhani',sans-serif;font-weight:700;color:var(--g400);font-size:1rem;letter-spacing:0.05em;}
.footer-logo span{color:var(--accent);}
.footer-right{font-size:11px;color:var(--g400);font-family:'Share Tech Mono',monospace;letter-spacing:0.08em;}
.divider{height:1px;background:linear-gradient(90deg, transparent, rgba(226,75,74,0.3), transparent);margin:0;}
</style>
</head>
