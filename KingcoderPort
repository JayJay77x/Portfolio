<section class="skills-section" id="skills">
  <div class="skills-bg"></div>
  <div class="section-header">
    <div class="section-eyebrow">01 — Expertise</div>
    <h2>WHAT I <span>BUILD</span></h2>
  </div>
  <div class="skills-grid">
    <div class="skill-card">
